# The anon key is public by design — it is compiled into the browser bundle and
# is safe only because row-level security decides what it may read or write.
# NEVER put the service_role key in a VITE_ variable: it bypasses RLS entirely.
# It belongs only in the Edge Function environment, where Supabase injects it.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — MapTiler renders street labels in English (see README "Map labels").
# Without a key the map falls back to CARTO tiles, which show Chinese street names.
VITE_MAPTILER_KEY=
# Id of a MapTiler style with its label language set to English.
# Defaults to MapTiler's stock "streets-v2" (local-language labels) if unset.
VITE_MAPTILER_STYLE=

# Optional — only needed if you switch the map provider from Leaflet to AMap (Gaode)
VITE_AMAP_KEY=
