# The anon key is public by design — it is compiled into the browser bundle and
# is safe only because row-level security decides what it may read or write.
# NEVER put the service_role key in a VITE_ variable: it bypasses RLS entirely.
# It belongs only in the Edge Function environment, where Supabase injects it.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — MapTiler renders street labels in English (see README "Map labels").
# Without a key the map falls back to CARTO tiles, which show Chinese street names.
VITE_MAPTILER_KEY=
# Id of a MapTiler style with its label language set to English.
# Defaults to MapTiler's stock "streets-v2" (local-language labels) if unset.
VITE_MAPTILER_STYLE=

# Optional — id of a dark MapTiler style, used when the interface is in night
# mode. Leave it empty and night mode keeps the light basemap above, which is
# preferred over a stock dark style because a stock style loses the English
# labels. Duplicate your English style in MapTiler and switch it to a dark base.
VITE_MAPTILER_STYLE_DARK=

# Optional — an OSRM-compatible routing server for "By road" distances.
# Defaults to OSRM's public demo server, which needs no account but makes no
# uptime promise and asks not to be used for production load. Point this at a
# self-hosted or commercial OSRM instance before depending on it. Note that
# whichever server this is, factory coordinates are sent to it.
VITE_ROUTING_URL=
# The OSRM profile to request. Profiles are compiled into a server, so this only
# matters if yours was built with more than the demo's 'driving'.
VITE_ROUTING_PROFILE=

# Optional — only needed if you switch the map provider from Leaflet to AMap (Gaode)
VITE_AMAP_KEY=
